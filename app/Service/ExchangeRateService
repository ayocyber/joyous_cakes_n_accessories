<?php

namespace App\Services;

use App\Models\ExchangeRate;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Cache;

class ExchangeRateService
{
    public static function updateRates(): void
    {
        $response = Http::get('https://open.er-api.com/v6/latest/USD');

        if (!$response->ok()) {
            return;
        }

        $data = $response->json();

        foreach ($data['rates'] as $currency => $rate) {

            ExchangeRate::updateOrCreate(
                [
                    'base_currency' => 'USD',
                    'currency' => $currency,
                ],
                [
                    'rate' => $rate,
                ]
            );
        }

        Cache::forget('exchange_rates');
    }

    public static function getRate(string $from, string $to): float
    {
        if ($from === $to) return 1;

        return Cache::remember("exchange_rates_{$from}_{$to}", 86400, function () use ($from, $to) {

            $fromRate = ExchangeRate::where('base_currency', 'USD')
                ->where('currency', $from)
                ->value('rate');

            $toRate = ExchangeRate::where('base_currency', 'USD')
                ->where('currency', $to)
                ->value('rate');

            if (!$fromRate || !$toRate) return 1;

            return $toRate / $fromRate;
        });
    }

    public static function convert(float $amount, string $from, string $to): float
    {
        return $amount * self::getRate($from, $to);
    }
}